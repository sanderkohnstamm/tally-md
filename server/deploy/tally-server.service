[Unit]
Description=Tally assistant server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wakey
WorkingDirectory=/tally/server
Environment=TALLY_ENV_FILE=/tally/.env
ExecStart=/tally/server/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8321
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
